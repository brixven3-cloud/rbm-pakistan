# ──────────────────────────────────────────────────────────────
# Supabase (required — copy from project Settings → API)
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ──────────────────────────────────────────────────────────────
# App
# ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Root domain for subdomain routing
# Production:  rbmpakistan.com
# Local dev:   localhost
# To test subdomains locally, add to C:\Windows\System32\drivers\etc\hosts:
#   127.0.0.1  app.localhost
#   127.0.0.1  demo.localhost
NEXT_PUBLIC_ROOT_DOMAIN=localhost

# ──────────────────────────────────────────────────────────────
# Payment gateways (sandbox keys only — owner enters live keys)
# ──────────────────────────────────────────────────────────────
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
JAZZCASH_RETURN_URL=http://localhost:3000/api/webhooks/jazzcash

EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
EASYPAISA_RETURN_URL=http://localhost:3000/api/webhooks/easypaisa

SAFEPAY_API_KEY=
SAFEPAY_SECRET_KEY=
SAFEPAY_WEBHOOK_SECRET=
SAFEPAY_ENV=sandbox
